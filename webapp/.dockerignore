# Only what the Dockerfile copies is sent to the builder; everything else (node_modules,
# dist, tests, coverage output, .env files) stays local
*
!pyproject.toml
!uv.lock
!README.md
!main.py
!app/
!templates/
!static/
!db/migrations/
!package.json
!package-lock.json
!vite.config.js
!src/
**/__pycache__
src/**/*.test.js
src/test/
