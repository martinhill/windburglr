{
  "name": "windburglr-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "python -m http.server 3000",
    "test:store": "npm run dev & sleep 3 && open http://localhost:5173/src/test/test-store.html",
    "test:nav": "npm run dev & sleep 3 && open http://localhost:5173/src/test/test-navigation.html"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^4.9.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "jsdom": "^26.1.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "chartjs-adapter-date-fns": "^3.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "@sentry/cli": false
  }
}
